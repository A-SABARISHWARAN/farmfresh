{
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "database/firestore.rules",
    "indexes": "database/firestore.indexes.json"
  },
  "auth": {
    "providers": {
      "emailPassword": true
    }
  },
  "hosting": {
    "public": "frontend",
    "ignore": [
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
